# Copy to .env (setup scripts do this for you). Every value is optional.
# tracker.py loads .env before anything else, so the path overrides below work here too.

# ── Linda assistant ───────────────────────────────────────────────────────────
# ollama (local, default when reachable) | claude | auto (Ollama, else Claude)
LINDA_BACKEND=auto
# Ollama server; defaults to the value saved in Settings, else http://localhost:11434
# OLLAMA_HOST=http://localhost:11434
# Bootstrap model before a model is picked in Settings (LINDA_MODEL, then RESUME_MODEL)
# LINDA_MODEL=qwen2.5:1.5b-instruct
# RESUME_MODEL=qwen2.5:1.5b-instruct

# Optional Claude fallback
# ANTHROPIC_API_KEY=your-anthropic-key
# LINDA_CLAUDE_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL=

# ── Web research tools ────────────────────────────────────────────────────────
# Tavily search for Linda (free tier at tavily.com)
# TAVILY_API_KEY=your-tavily-key
# Exa search for the job scanner / company intel (OPENAI_API_KEY is read as a legacy fallback)
# EXA_API_KEY=your-exa-key
# OPENAI_API_KEY=

# ── Data locations (defaults: files next to app.py) ───────────────────────────
# `app.py --demo` points all of these at demo/ for you.
# ASCENT_DB=career.db
# ASCENT_SETTINGS=settings.yaml
# ASCENT_PROFILE=profile.yaml
# TRACKER_DATA=data.yaml
# Day templates; until this file exists schedule.example.yaml is read
# ASCENT_SCHEDULE=schedule.yaml
# Folder of daily job-pull runs (YYYY-MM-DD/...) read by Applications and Today (default data/job_runs)
# ASCENT_JOB_RUNS=
# Where project `path`s live. Draft with Linda only reads files inside it, and PROJECTS.md
# is written there (default: your home folder; PROJECTS.md then goes next to career.db)
# ASCENT_PROJECTS_ROOT=
# Backend port for app.py (default 5001; the demo uses 5002)
# ASCENT_PORT=5001

# ── Dev ───────────────────────────────────────────────────────────────────────
# ASCENT_DEV=1    # same as `python app.py --dev` (Vite + HMR)
# FLASK_DEBUG=1   # debug mode when running tracker.py directly
